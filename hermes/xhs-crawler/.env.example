# XHS Crawler 配置文件
# 复制为 .env 文件并填写你的 API Key

# Kimi API Key（报告生成）
KIMI_API_KEY=sk-your-kimi-api-key-here

# Qwen3-VL API URL（OCR识别，本地部署）
QWEN_API_URL=http://172.16.27.10:9998/v1/chat/completions

# Chrome CDP URL（默认使用 OpenClaw Extension 端口 ws://127.0.0.1:18792/cdp）
# 如使用 Comet，设置为 http://127.0.0.1:19222
CHROME_CDP_URL=ws://127.0.0.1:18792/cdp

# DeepSeek API Key（可选，备选方案）
# DEEPSEEK_API_KEY=sk-xxx

# OpenAI API Key（可选）
# OPENAI_API_KEY=sk-xxx
