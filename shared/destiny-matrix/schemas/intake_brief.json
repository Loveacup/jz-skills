{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake_brief.json",
  "title": "intake_brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "known_events", "open_gaps", "questions_for_user", "personality_input", "time_input", "scope", "timing_request", "analysis_as_of", "privacy", "synastry", "age_years", "minor_mode", "audience", "cost_policy"],
  "properties": {
    "subject": {"$ref":"#/$defs/subject"},
    "known_events":{"type":"array","items":{"type":["object","string"]}}, "open_gaps":{"type":"array","items":{"type":"string"}}, "questions_for_user":{"type":"array","items":{"type":"string"}},
    "personality_input":{"$ref":"#/$defs/personality_input"}, "time_input":{"$ref":"#/$defs/time_input"},
    "scope":{"type":"object","required":["mode","requested_topics","accepted_limits"],"properties":{"mode":{"enum":["full","focused"]},"requested_topics":{"type":"array","uniqueItems":true,"items":{"enum":["personality","bazi","ziwei","astrology","synthesis","timing","relationships","practice","career","wellbeing","synastry"]}},"accepted_limits":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "timing_request":{"type":"object","required":["years","months","systems"],"properties":{"years":{"type":"array","uniqueItems":true,"items":{"type":"integer"}},"months":{"type":"array","items":{"type":"object","required":["year","month"],"properties":{"year":{"type":"integer"},"month":{"type":"integer","minimum":1,"maximum":12}},"additionalProperties":false}},"systems":{"type":"array","uniqueItems":true,"items":{"enum":["bazi","ziwei","astrology"]}}},"additionalProperties":false},
    "analysis_as_of":{"type":"string","format":"date"}, "privacy":{"type":"object","required":["external_chart_submission","retain_case_memory"],"properties":{"external_chart_submission":{"const":false},"retain_case_memory":{"const":false}},"additionalProperties":false},
    "synastry":{"type":"object","required":["enabled","partner"],"properties":{"enabled":{"type":"boolean"},"partner":{"oneOf":[{"$ref":"#/$defs/partner"},{"type":"null"}]}},"additionalProperties":false},
    "age_years":{"type":["integer","null"],"minimum":0}, "minor_mode":{"type":["boolean","null"]}, "audience":{"enum":["subject","guardian","both"]},
    "cost_policy":{"type":["object","null"],"properties":{"max_elapsed_minutes":{"type":["number","null"],"exclusiveMinimum":0},"max_input_tokens":{"type":["integer","null"],"minimum":1},"max_output_tokens":{"type":["integer","null"],"minimum":1}},"additionalProperties":false}
  },
  "$defs": {
    "subject":{"type":"object","required":["date_calendar","calculation_sex","birth_date","lunar_date"],"properties":{"date_calendar":{"enum":["gregorian","julian"]},"calculation_sex":{"type":["string","null"],"enum":["m","f",null]},"birth_date":{"type":["string","null"],"format":"date"},"lunar_date":{"type":["object","null"],"required":["year","month","day","is_leap_month"],"properties":{"year":{"type":"integer"},"month":{"type":"integer","minimum":1,"maximum":12},"day":{"type":"integer","minimum":1,"maximum":30},"is_leap_month":{"type":"boolean"}},"additionalProperties":false},"location":{"type":["object","null"]}},"additionalProperties":true},
    "personality_input":{"type":"object","required":["instrument","version","test_date","construct","scores","scale_min","scale_max","self_reported_type","observations","counterexamples","transcription"],"properties":{"instrument":{"type":["string","null"]},"version":{"type":["string","null"]},"test_date":{"type":["string","null"],"format":"date"},"construct":{"enum":["functions8","subtypes16","neris5","mbti_type","interview","none"]},"scores":{"type":["object","null"],"additionalProperties":{"type":"number"}},"scale_min":{"type":["number","null"]},"scale_max":{"type":["number","null"]},"self_reported_type":{"type":["string","null"]},"observations":{"type":"array","items":{"type":"string"}},"counterexamples":{"type":"array","items":{"type":"string"}},"transcription":{"type":["object","null"],"required":["image_refs","first_pass","second_pass","differences","status"],"properties":{"image_refs":{"type":"array","items":{"type":"string"}},"first_pass":{"type":"array","items":{"$ref":"#/$defs/transcription_value"}},"second_pass":{"type":"array","items":{"$ref":"#/$defs/transcription_value"}},"differences":{"type":"array","items":{"type":"object"}},"status":{"enum":["verified","needs_clarification"]}},"additionalProperties":false}},"additionalProperties":false},
    "transcription_value":{"type":"object","required":["key","value","scale","source_image_id","region"],"properties":{"key":{"type":"string"},"value":{"type":["number","null"]},"scale":{"type":["string","number","null"]},"source_image_id":{"type":"string"},"region":{"type":"string"}},"additionalProperties":false},
    "time_input":{"type":"object","required":["precision","start","end","branch_label","timezone_name","utc_offset_hours","fold","clock_basis"],"properties":{"precision":{"enum":["minute","range","branch","unknown"]},"start":{"type":["string","null"]},"end":{"type":["string","null"]},"branch_label":{"type":["string","null"]},"timezone_name":{"type":["string","null"]},"utc_offset_hours":{"type":["number","null"]},"fold":{"type":["integer","null"],"enum":[0,1,null]},"clock_basis":{"enum":["civil","local_mean_solar","local_apparent_solar","unknown"]}},"additionalProperties":false},
    "partner":{"type":"object","required":["subject","time_input","personality_input","known_events"],"properties":{"subject":{"$ref":"#/$defs/subject"},"time_input":{"$ref":"#/$defs/time_input"},"personality_input":{"$ref":"#/$defs/personality_input"},"known_events":{"type":"array"}},"additionalProperties":false}
  }
}
